+use quench3d_math::{vec3, Vec3};
+use quench3d_physics::{BodyBuilder, PhysicsWorld, Shape};
+fn sample(layers: usize, global: bool) -> f64 {
+    let mut w = PhysicsWorld::new();
+    w.set_fixed_dt(1.0 / 60.0);
+    w.config.global_normal_projection = global;
+    w.config.speculative_margin = 0.005;
+    w.config.velocity_iterations = 20;
+    w.config.position_iterations = 8;
+    w.add_builder(
+        BodyBuilder::r#static(Shape::Box {
+            half_extents: vec3(4.0, 0.25, 4.0),
+        })
+        .position(vec3(0.0, -0.25, 0.0)),
+    );
+    for i in 0..layers {
+        w.add_builder(
+            BodyBuilder::dynamic(Shape::Box {
+                half_extents: Vec3::splat(0.25),
+            })
+            .position(vec3(0.0, 0.25 + i as f32 * 0.502, 0.0))
+            .mass(1.0),
+        );
+    }
+    for _ in 0..8 {
+        w.step(1.0 / 60.0);
+    }
+    PhysicsWorld::diagnostic_profile_196();
+    let mut contact_samples = 0;
+    let mut awake_samples = 0;
+    let mut first_sleep = None;
+    let start = std::time::Instant::now();
+    for step in 0..120 {
+        w.step(1.0 / 60.0);
+        contact_samples += w.contacts().len();
+        let awake = w
+            .bodies()
+            .filter(|(_, b)| !b.is_sleeping() && b.body_type == quench3d_physics::BodyType::Dynamic)
+            .count();
+        awake_samples += awake;
+        if awake == 0 && first_sleep.is_none() {
+            first_sleep = Some(step + 9);
+        }
+    }
+    let elapsed = start.elapsed().as_secs_f64();
+    println!("ROUND196 layers={layers} global={global} diagnostic_seconds={elapsed:.9} contactsamples={contact_samples} awakesamples={awake_samples} first_all_sleep={first_sleep:?} phases_ns_calls={:?}",PhysicsWorld::diagnostic_profile_196());
+    assert_eq!(w.step_count, 128);
+    std::hint::black_box(
+        w.bodies()
+            .map(|(_, b)| (b.position(), b.linear_velocity))
+            .collect::<Vec<_>>(),
+    );
+    elapsed
+}
+fn main() {
+    for layers in [12, 32] {
+        for global in [false, true] {
+            sample(layers, global);
+        }
+    }
+}
