+thread_local! {static PROFILE196:std::cell::RefCell<[(u128,u64);12]>=const {std::cell::RefCell::new([(0,0);12])};}
+fn profile196_start() -> Option<std::time::Instant> {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if *ON.get_or_init(|| std::env::var_os("Q196_PROFILE").is_some()) {
+        Some(std::time::Instant::now())
+    } else {
+        None
+    }
+}
+fn profile196_end(i: usize, t: Option<std::time::Instant>) {
+    if let Some(t) = t {
+        PROFILE196.with(|p| {
+            let mut p = p.borrow_mut();
+            p[i].0 += t.elapsed().as_nanos();
+            p[i].1 += 1;
+        });
+    }
+}
+pub(crate) fn profile196_take() -> [(u128, u64); 12] {
+    PROFILE196.with(|p| std::mem::replace(&mut *p.borrow_mut(), [(0, 0); 12]))
+}
