+        for mask in 0..16 {
+            let free: Vec<_> = (0..4).map(|i| mask & (1 << i) != 0).collect();
+            for probe in 0..6 {
+                let r: Vec<_> = (0..4)
+                    .map(|i| {
+                        if probe == 0 {
+                            -0.0
+                        } else {
+                            0.13 + (i + probe) as f64 * 0.27
+                        }
+                    })
+                    .collect();
+                let z = geometry.apply_diagonal(&cs, &r, &free);
+                let mut energy = 0.0;
+                for i in 0..4 {
+                    let expected = if free[i] {
+                        r[i] / f64::from(cs[i].k_normal)
+                    } else {
+                        0.0
+                    };
+                    assert_eq!(
+                        z[i].to_bits(),
+                        expected.to_bits(),
+                        "mask={mask} probe={probe} i={i}"
+                    );
+                    energy += r[i] * z[i];
+                }
+                if mask != 0 && probe != 0 {
+                    assert!(energy > 0.0);
+                }
+            }
+        }
+        assert!(!geometry.ready);
+        println!("ROUND213 diagonal-only 16masks6probes signedzero formula rawbits SPD PASS");
