+thread_local! {static PROFILE212:std::cell::RefCell<([u128;10],[usize;10])>=const{std::cell::RefCell::new(([0;10],[0;10]))};}
+fn note212(i: usize, t: std::time::Instant) {
+    PROFILE212.with(|p| {
+        let mut p = p.borrow_mut();
+        p.0[i] += t.elapsed().as_nanos();
+        p.1[i] += 1;
+    });
+}
+pub(crate) fn take212() -> ([u128; 10], [usize; 10]) {
+    PROFILE212.with(|p| std::mem::replace(&mut *p.borrow_mut(), ([0; 10], [0; 10])))
+}
