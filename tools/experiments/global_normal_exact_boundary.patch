+fn projected_line_update(lambda: &[f64], p: &[f64], alpha: f64) -> Vec<f32> {
+    lambda
+        .iter()
+        .zip(p)
+        .map(|(l, p)| {
+            if *p < 0.0 && alpha == -*l / *p {
+                0.0
+            } else {
+                (l + alpha * p).max(0.0) as f32
+            }
+        })
+        .collect()
