+thread_local! {static DIAG206:std::cell::RefCell<([usize;8],[usize;20])>=const{std::cell::RefCell::new(([0;8],[0;20]))};}
+fn diag206_snapshot(
+    cs: &[SolverContact],
+    vs: &[BodyView],
+    m: &NormalDirectionMemory,
+) -> (Vec<u32>, Vec<u64>) {
+    let mut p = Vec::new();
+    for v in vs {
+        for x in [v.lin.x, v.lin.y, v.lin.z, v.ang.x, v.ang.y, v.ang.z] {
+            p.push(x.to_bits());
+        }
+    }
+    for c in cs {
+        p.extend([
+            c.normal_impulse.to_bits(),
+            c.tangent_impulse[0].to_bits(),
+            c.tangent_impulse[1].to_bits(),
+        ]);
+    }
+    let mut q = vec![
+        m.p.len() as u64,
+        m.ap.len() as u64,
+        m.free.len() as u64,
+        m.curvature.to_bits(),
+    ];
+    q.extend(m.p.iter().map(|x| x.to_bits()));
+    q.extend(m.ap.iter().map(|x| x.to_bits()));
+    q.extend(m.free.iter().map(|x| u64::from(*x)));
+    (p, q)
+}
+fn diag206_record(before: (Vec<u32>, Vec<u64>), after: (Vec<u32>, Vec<u64>), ready: bool) {
+    DIAG206.with(|d| {
+        let mut d = d.borrow_mut();
+        if !ready {
+            d.0[6] = 0;
+            d.0[7] = 0;
+        }
+        let round = d.0[6];
+        d.0[6] += 1;
+        d.0[0] += 1;
+        let physical = before.0 == after.0;
+        let memory = before.1 == after.1;
+        if !memory {
+            d.0[3] += 1;
+        }
+        if physical {
+            d.0[1] += 1;
+            if !memory {
+                d.0[2] += 1;
+            }
+        }
+        if ready && physical && memory {
+            d.0[4] += 1;
+            d.0[7] += 1;
+            d.0[5] = d.0[5].max(d.0[7]);
+            if round < 20 {
+                d.1[round] += 1;
+            }
+        } else {
+            d.0[7] = 0;
+        }
+    });
+}
+pub(crate) fn diag206_take() -> ([usize; 8], [usize; 20]) {
+    DIAG206.with(|d| std::mem::replace(&mut *d.borrow_mut(), ([0; 8], [0; 20])))
+}
