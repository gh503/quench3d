+fn solve_normal_block(
+    contacts: &mut [SolverContact],
+    va: &mut BodyView,
+    vb: &mut BodyView,
+) -> bool {
+    let count = contacts.len();
+    if !(2..=4).contains(&count) {
+        return false;
+    }
+    let first = contacts[0];
+    if contacts.iter().any(|c| {
+        c.a != first.a
+            || c.b != first.b
+            || c.normal != first.normal
+            || c.rolling_friction != 0.0
+            || !c.ra.is_finite()
+            || !c.rb.is_finite()
+            || (c.ra - first.ra).dot(first.normal).abs() > 1e-5
+            || (c.rb - first.rb).dot(first.normal).abs() > 1e-5
+    }) {
+        return false;
+    }
+    let mut k = [[0.0; 4]; 4];
+    for i in 0..count {
+        for j in 0..count {
+            let a = contacts[i].ra.cross(first.normal);
+            let b = contacts[i].rb.cross(first.normal);
+            k[i][j] = f64::from(va.inv_m + vb.inv_m)
+                + f64::from(a.dot(va.inv_i_world(contacts[j].ra.cross(first.normal))))
+                + f64::from(b.dot(vb.inv_i_world(contacts[j].rb.cross(first.normal))));
+        }
+    }
+    let saved_a = *va;
+    let saved_b = *vb;
+    let saved: [SolverContact; 4] = std::array::from_fn(|i| contacts[i.min(count - 1)]);
+    for c in contacts.iter_mut() {
+        solve_block_friction(c, va, vb);
+    }
+    let mut b = [0.0; 4];
+    for i in 0..count {
+        b[i] = f64::from(
+            pair_relative_velocity(va, vb, contacts[i].ra, contacts[i].rb).dot(first.normal)
+                - contacts[i].restitution_bias
+                - contacts[i].speculative_bias,
+        ) - (0..count)
+            .map(|j| k[i][j] * f64::from(contacts[j].normal_impulse))
+            .sum::<f64>();
+    }
+    let Some(lambda) = block_lcp(k, b, count) else {
+        *va = saved_a;
+        *vb = saved_b;
+        contacts.copy_from_slice(&saved[..count]);
+        return false;
+    };
+    for (i, c) in contacts.iter_mut().enumerate() {
+        let new = lambda[i] as f32;
+        let delta = new - c.normal_impulse;
+        c.normal_impulse = new;
+        if delta != 0.0 {
+            if c.precomputed {
+                apply_precomputed(va, vb, c.normal, c.normal_arm, delta);
+            } else {
+                pair_apply_impulse(va, vb, c.ra, c.rb, c.normal * delta);
+            }
+        }
+    }
+    true
 }
 
