+/// Solve a small PSD normal LCP using deterministic independent active subsets.
+fn block_lcp(k: [[f64; 4]; 4], b: [f64; 4], count: usize) -> Option<[f64; 4]> {
+    let scale = (0..count).map(|i| k[i][i].abs()).fold(0.0, f64::max);
+    if !scale.is_finite() || scale <= 1e-12 || b[..count].iter().any(|x| !x.is_finite()) {
+        return None;
+    }
+    let tolerance = 1e-8 * (1.0 + b[..count].iter().map(|x| x.abs()).fold(0.0, f64::max));
+    for cardinality in (0..=3.min(count)).rev() {
+        for mask in 0u32..(1 << count) {
+            if mask.count_ones() as usize != cardinality {
+                continue;
+            }
+            let mut indices = [0; 3];
+            let mut n = 0;
+            for i in 0..count {
+                if mask & (1 << i) != 0 {
+                    indices[n] = i;
+                    n += 1;
+                }
+            }
+            let mut matrix = [[0.0; 4]; 3];
+            for i in 0..n {
+                for j in 0..n {
+                    matrix[i][j] = k[indices[i]][indices[j]];
+                }
+                matrix[i][n] = -b[indices[i]];
+            }
+            let mut valid = true;
+            for col in 0..n {
+                let pivot = (col..n)
+                    .max_by(|a, b| matrix[*a][col].abs().total_cmp(&matrix[*b][col].abs()))
+                    .unwrap();
+                if !matrix[pivot][col].is_finite() || matrix[pivot][col].abs() <= scale * 1e-9 {
+                    valid = false;
+                    break;
+                }
+                matrix.swap(col, pivot);
+                let divisor = matrix[col][col];
+                for j in col..=n {
+                    matrix[col][j] /= divisor;
+                }
+                for i in 0..n {
+                    if i == col {
+                        continue;
+                    }
+                    let factor = matrix[i][col];
+                    for j in col..=n {
+                        matrix[i][j] -= factor * matrix[col][j];
+                    }
+                }
+            }
+            if !valid {
+                continue;
+            }
+            let mut lambda = [0.0; 4];
+            for i in 0..n {
+                lambda[indices[i]] = matrix[i][n];
+            }
+            if lambda[..count].iter().any(|x| !x.is_finite() || *x < 0.0) {
+                continue;
+            }
+            if (0..count).all(|i| {
+                let w = b[i] + (0..count).map(|j| k[i][j] * lambda[j]).sum::<f64>();
+                w.is_finite()
+                    && if mask & (1 << i) != 0 {
+                        w.abs() <= tolerance
+                    } else {
+                        w >= -tolerance
+                    }
+            }) {
+                return Some(lambda);
+            }
+        }
+    }
+    None
+}
