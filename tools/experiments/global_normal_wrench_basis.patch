+fn small_spd_inverse(a: [[f64; 3]; 3], n: usize, scale: f64) -> Option<[[f64; 3]; 3]> {
+    let mut l = [[0.0; 3]; 3];
+    for i in 0..n {
+        for j in 0..=i {
+            let mut x = a[i][j];
+            for k in 0..j {
+                x -= l[i][k] * l[j][k];
+            }
+            if i == j {
+                if !x.is_finite() || x <= scale * 1e-9 {
+                    return None;
+                }
+                l[i][j] = x.sqrt();
+            } else {
+                l[i][j] = x / l[j][j];
+            }
+        }
+    }
+    let mut inv = [[0.0; 3]; 3];
+    for col in 0..n {
+        let mut x = [0.0; 3];
+        for i in 0..n {
+            let mut rhs = if i == col { 1.0 } else { 0.0 };
+            for j in 0..i {
+                rhs -= l[i][j] * x[j];
+            }
+            x[i] = rhs / l[i][i];
+        }
+        for i in (0..n).rev() {
+            let mut rhs = x[i];
+            for j in i + 1..n {
+                rhs -= l[j][i] * inv[j][col];
+            }
+            inv[i][col] = rhs / l[i][i];
+        }
+    }
+    Some(inv)
+}
