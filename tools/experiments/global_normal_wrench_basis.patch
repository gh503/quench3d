+mod stack_oracle {
+    use super::*;
+    fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+        (0..3).map(|i| a[i] * b[i]).sum()
+    }
+    fn sub(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+        [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+    }
+    fn cross(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+        [
+            a[1] * b[2] - a[2] * b[1],
+            a[2] * b[0] - a[0] * b[2],
+            a[0] * b[1] - a[1] * b[0],
+        ]
+    }
+    #[derive(Clone, Copy, Debug)]
+    pub(super) struct Obb {
+        pub(super) center: [f64; 3],
+        pub(super) axes: [[f64; 3]; 3],
+        pub(super) half: [f64; 3],
+    }
+    impl Obb {
+        pub(super) fn read(world: &PhysicsWorld, handle: crate::BodyHandle) -> Self {
+            let body = world.body(handle).unwrap();
+            let p = body.position();
+            let q = body.rotation();
+            let [x, y, z, w] = [q.x, q.y, q.z, q.w].map(f64::from);
+            let axes = [
+                [
+                    1.0 - 2.0 * (y * y + z * z),
+                    2.0 * (x * y + z * w),
+                    2.0 * (x * z - y * w),
+                ],
+                [
+                    2.0 * (x * y - z * w),
+                    1.0 - 2.0 * (x * x + z * z),
+                    2.0 * (y * z + x * w),
+                ],
+                [
+                    2.0 * (x * z + y * w),
+                    2.0 * (y * z - x * w),
+                    1.0 - 2.0 * (x * x + y * y),
+                ],
+            ];
+            Self {
+                center: [f64::from(p.x), f64::from(p.y), f64::from(p.z)],
+                axes,
+                half: [0.25; 3],
+            }
+        }
+        fn corners(self) -> [[f64; 3]; 8] {
+            std::array::from_fn(|i| {
+                std::array::from_fn(|axis| {
+                    self.center[axis]
+                        + (0..3)
+                            .map(|j| {
+                                (if i & (1 << j) == 0 {
+                                    -self.half[j]
+                                } else {
+                                    self.half[j]
+                                }) * self.axes[j][axis]
+                            })
+                            .sum::<f64>()
