+pub(crate) fn solve_velocity_contacts_reverse(
+    contacts: &mut [SolverContact],
+    views: &mut [BodyView],
+) {
+    for c in contacts.iter_mut().rev() {
+        let Some((va, vb)) = split_body_pair(views, c.a, c.b) else {
+            continue;
+        };
+        solve_velocity_contact(c, va, vb);
+    }
