+#[test]
+fn alternating_sweep_sustained_precision_target() {
+    let mut failures = Vec::new();
+    for layers in [4, 12, 32] {
+        let (pair, floor) = run_duration_order(
+            layers,
+            1800,
+            quench3d_physics::ContactSweepOrder::Alternating,
+        );
+        if pair > 0.00501 || floor > 0.00501 {
+            failures.push((layers, pair, floor));
+        }
+    }
+    assert!(
+        failures.is_empty(),
+        "preregistered alternating32layer5mm candidate acceptance: {failures:?}"
+    );
+}
