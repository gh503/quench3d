+fn mismatch(expected: &[u8], actual: &[u8]) -> String {
+    let mut p = 0;
+    while p < expected.len().min(actual.len()) {
+        let start = p;
+        let n = u32::from_le_bytes(expected[p..p + 4].try_into().unwrap()) as usize;
+        p += 4;
+        let tag = String::from_utf8_lossy(&expected[p..p + n]);
+        p += n;
+        let n = u64::from_le_bytes(expected[p..p + 8].try_into().unwrap()) as usize;
+        p += 8;
+        let end = p + n;
+        if end > actual.len() || expected[start..end] != actual[start..end] {
+            return format!(
+                "field={tag} recordoffset={start} expected={:?} actual={:?}",
+                &expected[p..end],
+                actual.get(p..end)
+            );
+        }
+        p = end;
+    }
+    format!("length expected={} actual={}", expected.len(), actual.len())
+}
+#[test]
+#[ignore = "explicit baseline/candidate canonical default compatibility"]
+fn default_false_canonical_193() {
+    let root = std::env::var("Q193_OUTPUT").expect("Q193_OUTPUT");
+    let mode = std::env::var("Q193_MODE").unwrap();
+    std::fs::create_dir_all(&root).unwrap();
+    println!(
+        "ROUND193 hardware={:?} mode={mode}",
+        std::thread::available_parallelism()
+    );
+    for (name, kind, parallel, steps) in [
+        ("columns_serial", 0, false, 240),
+        ("columns_parallel", 0, true, 240),
+        ("joints_serial", 1, false, 180),
+        ("joints_parallel", 1, true, 180),
+        ("mixed", 2, false, 400),
+    ] {
+        let mut w = fixture(kind, parallel);
+        let path = std::path::Path::new(&root).join(format!("{name}.bin"));
+        let mut file = if mode == "generate" {
+            std::fs::File::create(path).unwrap()
+        } else {
+            std::fs::File::open(path).unwrap()
+        };
+        let mut parallel_steps = 0;
+        let mut maxthreads = 0;
+        let mut total = 0;
+        for step in 1..=steps {
+            w.step(1.0 / 60.0);
+            assert_eq!(w.step_count, step);
+            parallel_steps += usize::from(w.uses_parallel_solver());
+            maxthreads = maxthreads.max(w.solver_threads());
+            let bytes = snapshot(&w);
+            total += bytes.len();
+            if mode == "generate" {
+                file.write_all(&(bytes.len() as u64).to_le_bytes()).unwrap();
+                file.write_all(&bytes).unwrap();
+            } else {
+                let mut n = [0; 8];
+                file.read_exact(&mut n).unwrap();
+                let mut expected = vec![0; u64::from_le_bytes(n) as usize];
+                file.read_exact(&mut expected).unwrap();
+                assert!(
+                    bytes == expected,
+                    "case={name} step={step} {}",
+                    mismatch(&expected, &bytes)
+                );
+            }
+        }
+        if mode != "generate" {
+            let mut one = [0];
+            assert_eq!(file.read(&mut one).unwrap(), 0);
+        }
+        if parallel {
+            assert!(
+                parallel_steps > 0 && maxthreads >= 2,
+                "actual parallel coverage required"
+            );
+        }
+        println!("ROUND193 case={name} steps={steps} bytes={total} parallelsteps={parallel_steps} maxthreads={maxthreads}");
+    }
