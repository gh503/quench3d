+#[derive(Default)]
+struct Encoder {
+    bytes: Vec<u8>,
+}
+impl Encoder {
+    fn field(&mut self, tag: &str, bytes: &[u8]) {
+        self.bytes.extend((tag.len() as u32).to_le_bytes());
+        self.bytes.extend(tag.as_bytes());
+        self.bytes.extend((bytes.len() as u64).to_le_bytes());
+        self.bytes.extend(bytes);
+    }
+    fn u(&mut self, t: &str, v: u64) {
+        self.field(t, &v.to_le_bytes());
+    }
+    fn f(&mut self, t: &str, v: f32) {
+        self.field(t, &v.to_bits().to_le_bytes());
+    }
+    fn v(&mut self, t: &str, v: Vec3) {
+        for (axis, x) in [v.x, v.y, v.z].into_iter().enumerate() {
+            self.f(&format!("{t}.{axis}"), x);
+        }
+    }
+    fn q(&mut self, t: &str, q: Quat) {
+        for (i, x) in [q.x, q.y, q.z, q.w].into_iter().enumerate() {
+            self.f(&format!("{t}.{i}"), x);
+        }
+    }
+    fn handle(&mut self, t: &str, h: BodyHandle) {
+        self.u(&format!("{t}.index"), h.index as u64);
+        self.u(&format!("{t}.generation"), h.generation as u64);
+    }
+}
